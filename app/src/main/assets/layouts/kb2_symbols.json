        },
        {
          "label": "SPACE", "icon": "space",
          "style": "alphaKey",
          "isSplitKey": true,
          "splitLeftWeight": 2.0,
          "splitRightWeight": 2.0,
          "flexible": true,
          "onPress": {
            "type": "SEND_TEXT",
            "text": " "
          },
