{
  "id": "kb1_macro",
  "name": "KB1 Macro Layer",
  "version": "0.3.9",
  "_comment": "REMINDER: Always update this version number to match the keyboard baseVersionName in app/build.gradle.kts whenever modifications are made to this layout.",
  "author": "Infinikey IME",
  "description": "Code keyboard for vim/tmux shortcuts. Labels are concise (stab, gd, sf, sr, prefix z, etc.). Prefix shortcuts send Ctrl+B directly, shift shortcuts use the uppercase letter or s abbreviation, hjkl and arrows auto-repeat, and insertion keys return to kb2_letters. ABC returns to the letters layer and 123 opens kb2_numbers.",
  "metadata": {
    "horizontalSpacing": 4,
    "verticalSpacing": 4,
    "defaultScreenMode": "FULL_WIDTH_DOCKED",
    "defaultHeightPercentage": 32,
    "accessoryLayout": "none"
  },
  "theme": {
    "fontFamily": "Monospace"
  },
  "styles": {
    "alphaKey": {
      "cornerRadius": 8
    },
    "numberKey": {
      "cornerRadius": 8
    },
    "modifierKey": {
      "cornerRadius": 8
    },
    "functionKey": {
      "cornerRadius": 6
    },
    "actionKey": {
      "cornerRadius": 8
    },
    "navigationKey": {
      "cornerRadius": 8
    }
  },
